# ==========================================================================
# Clipax Bot - Environment configuration
# Copy this file to `.env` and fill in your real credentials.
#   cp .env.example .env
# ==========================================================================

# --- Server (local OAuth callback) ---
SERVER_API_URI="http://localhost:4090"
SERVER_API_REDIRECT_URI="http://localhost:4090/api/twitch/oauth/callback"
SERVER_API_PORT=4090

# --- Twitch ---
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_API_OAUTH_URI="https://id.twitch.tv"
TWITCH_API_URI="https://api.twitch.tv/helix"
TWITCH_CLIENT_ID="your_twitch_client_id"
TWITCH_CLIENT_SECRET="your_twitch_client_secret"
TWITCH_CLIENT_USERNAME="your_bot_username"
TWITCH_CLIENT_OAUTH_TOKEN="oauth:your_chat_token"

# --- Discord ---
# Create a bot at https://discord.com/developers/applications
DISCORD_API_URI="https://discord.com/api"
DISCORD_CLIENT_ID="your_discord_bot_client_id"
DISCORD_CLIENT_SECRET="your_discord_bot_secret"
DISCORD_CLIENT_USERNAME="Clipax"
DISCORD_CLIENT_OAUTH_TOKEN="your_discord_bot_token"
